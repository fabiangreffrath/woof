# This script is stamped out by CMake and run at install time.

set(PROJECT_NAME "@PROJECT_NAME@")
set(PROJECT_SHORTNAME "@PROJECT_SHORTNAME@")
set(CMAKE_CURRENT_SOURCE_DIR "@CMAKE_CURRENT_SOURCE_DIR@")
set(CMAKE_CURRENT_BINARY_DIR "@CMAKE_CURRENT_BINARY_DIR@")
set(PARAMS_DUMP "@PARAMS_DUMP@")
set(PANDOC_EXECUTABLE "@PANDOC_EXECUTABLE@")
set(BUILD_DATE "@BUILD_DATE@")

if(NOT EXISTS "${PARAMS_DUMP}")
    # Multi-config generators place the executable in a per-config subdirectory.
    file(GLOB CONFIG_DUMP "${CMAKE_CURRENT_BINARY_DIR}/*/params_dump")
    list(LENGTH CONFIG_DUMP count)
    if(count GREATER 0)
        list(GET CONFIG_DUMP 0 PARAMS_DUMP)
    endif()
endif()

if(NOT EXISTS "${PARAMS_DUMP}")
    message(FATAL_ERROR "params_dump not found, build the project before installing")
endif()

# Generate markdown
execute_process(COMMAND
    "${PARAMS_DUMP}" "${CMAKE_CURRENT_BINARY_DIR}/cmdline.md"
    "${PROJECT_NAME}" "${PROJECT_SHORTNAME}"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to generate markdown documentation")
endif()

# Generate man page
execute_process(COMMAND
    "${PANDOC_EXECUTABLE}" -s -t man
    --shift-heading-level-by=-1
    --metadata section=6
    --metadata date=${BUILD_DATE}
    --include-before-body=${CMAKE_CURRENT_SOURCE_DIR}/name.man
    --include-after-body=${CMAKE_CURRENT_SOURCE_DIR}/iwad_paths.man
    "${CMAKE_CURRENT_BINARY_DIR}/cmdline.md"
    -o "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_SHORTNAME}.6"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to generate man page")
endif()

# Generate bash completion
execute_process(COMMAND "${PARAMS_DUMP}" --names
    OUTPUT_VARIABLE param_names
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to list command line parameters")
endif()

string(REPLACE "\n" ";" param_names "${param_names}")
list(JOIN param_names " " param_names)

file(READ "${CMAKE_CURRENT_SOURCE_DIR}/bash-completion/woof.template" completion)
string(REPLACE "@SHORTNAME@" "${PROJECT_SHORTNAME}" completion "${completion}")
string(REPLACE "@content" "${param_names}" completion "${completion}")

file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/bash-completion")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/bash-completion/${PROJECT_SHORTNAME}" "${completion}")
