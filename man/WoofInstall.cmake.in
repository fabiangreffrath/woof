# This script is generated by CMake and run by `make install`.

set(PROJECT_NAME "@PROJECT_NAME@")
set(PROJECT_SHORTNAME "@PROJECT_SHORTNAME@")
set(PROJECT_SOURCE_DIR "@PROJECT_SOURCE_DIR@")
set(CMAKE_CURRENT_SOURCE_DIR "@CMAKE_CURRENT_SOURCE_DIR@")
set(CMAKE_CURRENT_BINARY_DIR "@CMAKE_CURRENT_BINARY_DIR@")
set(Python3_EXECUTABLE "@Python3_EXECUTABLE@")
set(PANDOC_EXECUTABLE "@PANDOC_EXECUTABLE@")
set(BUILD_DATE "@BUILD_DATE@")

execute_process(COMMAND
    "$<TARGET_FILE:woof>" -doc "${CMAKE_CURRENT_BINARY_DIR}/cmdline.md"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(WARNING "Failed to generate cmdline.md")
endif()

execute_process(COMMAND
    "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/bash_completion.py"
    "${CMAKE_CURRENT_BINARY_DIR}/cmdline.md"
    "${CMAKE_CURRENT_BINARY_DIR}/bash-completion/${PROJECT_SHORTNAME}"
    "${PROJECT_SHORTNAME}"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(WARNING "Failed to generate bash completion")
else()
    message(STATUS "Generated bash completion")
endif()

execute_process(COMMAND
    "${PANDOC_EXECUTABLE}" -s -t man
        --metadata title="${PROJECT_SHORTNAME}"
        --metadata section=6
        --metadata date="${BUILD_DATE}"
        "${CMAKE_CURRENT_BINARY_DIR}/cmdline.md"
        -o "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_SHORTNAME}.6"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(WARNING "Failed to generate man page")
else()
    message(STATUS "Generated man page")
endif()
